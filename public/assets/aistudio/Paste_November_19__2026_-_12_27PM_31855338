function applyAllIssueFilters() {
  var rows = document.querySelectorAll('#detailed-issues-table tbody tr');
  var searchVal = (document.getElementById('issue-search-input') ? document.getElementById('issue-search-input').value.toLowerCase().trim() : '');
  var visibleCount = 0;
  rows.forEach(function(row) {
    var sSev = row.getAttribute('data-sev');
    var sLine = row.getAttribute('data-line');
    var rowText = row.innerText.toLowerCase();
    var matchSev = (currentSevFilter === 'all' || sSev === currentSevFilter);
    var matchLine = (currentLineFilter === 'all' || sLine === currentLineFilter);
    var matchSearch = (!searchVal || rowText.indexOf(searchVal) !== -1);
    if (matchSev && matchLine && matchSearch) {
      row.style.display = '';
      visibleCount++;
    } else {
      row.style.display = 'none';
    }
  });
  var badge = document.getElementById('issue-count-badge');
  if (badge) badge.innerHTML = 'Hiển thị: <strong>' + visibleCount + '/10</strong> sự cố';
}

function filterIssuesBySeverity(sev) {
  currentSevFilter = sev;
  ['all', 'high', 'medium', 'low'].forEach(function(s) {
    var btn = document.getElementById('filter-sev-' + s);
    if (btn) {
      if (s === sev) {
        btn.className = 'px-2.5 py-1 rounded-md bg-blue-600 text-white shadow-sm transition';
      } else {
        btn.className = 'px-2.5 py-1 rounded-md text-slate-600 hover:text-slate-900 transition';
      }
    }
  });
  applyAllIssueFilters();
}

function filterIssuesByLine(line) {
  currentLineFilter = line;
  applyAllIssueFilters();
}

function searchIssuesTable(val) {
  applyAllIssueFilters();
}

function openIssueDetailModal(issueId) {
  var data = issueDatabase[issueId];
  if (!data) return;
  activeEditingIssueId = issueId;
  var modal = document.getElementById('modal-issue-detail');
  if (!modal) return;
  document.getElementById('modal-issue-code').innerText = issueId;
  document.getElementById('modal-issue-title').innerText = 'Hồ Sơ Sự Cố: ' + data.title;
  document.getElementById('detail-issue-line').innerText = data.line;
  document.getElementById('detail-issue-item').innerText = data.item;
  document.getElementById('detail-issue-sev').innerText = data.sev;
  document.getElementById('detail-issue-time').innerText = data.time;
  document.getElementById('detail-issue-desc').innerText = data.desc;
  document.getElementById('detail-issue-assignee').innerText = data.assignee;
  document.getElementById('detail-progress-range').value = data.progress;
  document.getElementById('detail-progress-val').innerText = data.progress + '%';
  document.getElementById('detail-issue-notes').value = data.notes;
  modal.classList.remove('hidden');
}

function closeIssueDetailModal() {
  var modal = document.getElementById('modal-issue-detail');
  if (modal) modal.classList.add('hidden');
}

function updateIssueProgress(issueId) {
  openIssueDetailModal(issueId);
}

function saveIssueProgressUpdate() {
  var newProgress = document.getElementById('detail-progress-range').value;
  var newNotes = document.getElementById('detail-issue-notes').value;
  if (issueDatabase[activeEditingIssueId]) {
    issueDatabase[activeEditingIssueId].progress = parseInt(newProgress, 10);
    issueDatabase[activeEditingIssueId].notes = newNotes;
  }
  var row = document.querySelector('tr[data-id="' + activeEditingIssueId + '"]');
  if (row) {
    var pBar = row.querySelector('.rounded-full > div');
    var pSpan = row.querySelector('.text-\\[11px\\] > span:last-child');
    if (pBar) pBar.style.width = newProgress + '%';
    if (pSpan) pSpan.innerText = newProgress + '%';
  }
  alert('Đã cập nhật tiến độ sự cố ' + activeEditingIssueId + ' lên ' + newProgress + '% thành công!');
  closeIssueDetailModal();
}

