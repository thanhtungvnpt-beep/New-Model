</footer><script id="toggle-demand-script">function toggleDemandSection(){var content=document.getElementById('line1-demand-collapsible-content');var text=document.getElementById('toggle-demand-text');var icon=document.getElementById('toggle-demand-icon');if(!content)return;if(content.classList.contains('hidden')){content.classList.remove('hidden');if(text)text.innerText='Thu gọn bảng';if(icon)icon.innerText='expand_less';}else{content.classList.add('hidden');if(text)text.innerText='Xem chi tiết định mức';if(icon)icon.innerText='expand_more';}}</script><script id="pipeline-filtering-script">
function getRowClassification(index) {
  // Indices 0..3: A1, A2, A3, A4 (completed test or reaching 100% target)
  // Indices 4..10: A5 (test 8/14), A6 (test 4), A7 (test 2), A8 (0 test), A9 (0 test), A10 (chờ kho), A11 (chờ kho)
  var isComplete = (index <= 3);
  var station = 'station6';
  if (index >= 9) station = 'station12';
  else if (index === 5 || index === 6) station = 'station3';
  else if (index === 7 || index === 8) station = 'station4';
  else if (index === 4) station = 'station5';
  else station = 'station6';
  return { isComplete: isComplete, station: station };
}

function updateFilterTabUI(activeTab) {
  ['all', 'incomplete', 'complete'].forEach(function(t) {
    var btn = document.getElementById('filter-btn-' + t);
    if (btn) {
      if (t === activeTab) {
        btn.className = 'px-2.5 py-1 rounded-md bg-blue-600 text-white shadow-sm transition';
      } else {
        btn.className = 'px-2.5 py-1 rounded-md text-slate-600 hover:text-slate-900 transition';
      }
    }
  });
}

function filterPipelineItems(mode) {
  updateFilterTabUI(mode);
  var select = document.getElementById('station-filter-select');
  if (select && mode !== 'all') select.value = 'all';
  var container = document.getElementById('pipeline-item-rows-container');
  if (!container) return;
  var rows = container.children;
  var visibleIncomplete = 0;
  var visibleComplete = 0;
  for (var i = 0; i < rows.length; i++) {
    var info = getRowClassification(i);
    var show = true;
    if (mode === 'incomplete') {
      show = !info.isComplete;
    } else if (mode === 'complete') {
      show = info.isComplete;
    }
    rows[i].style.display = show ? '' : 'none';
    if (show) {
      if (info.isComplete) visibleComplete++;
      else visibleIncomplete++;
    }
  }
  var counter = document.getElementById('pipeline-counter-pill');
  if (counter) {
    counter.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span><span>Đang chạy: <strong class="text-amber-700">' + visibleIncomplete + ' items</strong></span><span class="text-slate-300">|</span><span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span><span>Đã xong: <strong class="text-emerald-700">' + visibleComplete + ' items</strong></span>';
  }
}

function filterByStation(station) {
  var container = document.getElementById('pipeline-item-rows-container');
  if (!container) return;
  var rows = container.children;
  var visibleIncomplete = 0;
  var visibleComplete = 0;
  for (var i = 0; i < rows.length; i++) {
    var info = getRowClassification(i);
    var show = (station === 'all' || info.station === station);
    rows[i].style.display = show ? '' : 'none';
    if (show) {
      if (info.isComplete) visibleComplete++;
      else visibleIncomplete++;
    }
  }
  var counter = document.getElementById('pipeline-counter-pill');
  if (counter) {
    counter.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span><span>Đang chạy: <strong class="text-amber-700">' + visibleIncomplete + ' items</strong></span><span class="text-slate-300">|</span><span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span><span>Đã xong: <strong class="text-emerald-700">' + visibleComplete + ' items</strong></span>';
  }
}
</script>
